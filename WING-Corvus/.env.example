# ============ LLM 配置 ============
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
PLANNER_MODEL=deepseek-v4-flash
EXECUTOR_MODEL=deepseek-v4-flash

# ============ 模型路由 (opencode zen/go + 官方 flash) ============
# 三级降级: zen(免费 flash-free) → go(付费 flash, 无峰谷) → 官方 flash
# Opencode 全局 API Key (zen/go 端点兼容)
ZEN_API_KEY=sk-xxx
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=deepseek-v4-flash-free
# 关闭 zen 免费层 → 直接路由至 go (默认开启)
DISABLE_ZEN=true
GO_API_KEY=sk-xxx
GO_BASE_URL=https://opencode.ai/zen/go/v1
GO_MODEL=deepseek-v4-flash
# 官方 flash 兜底
FALLBACK_API_KEY=sk-xxx
FALLBACK_BASE_URL=https://api.deepseek.com/v1
FALLBACK_MODEL=deepseek-v4-flash
LLM_MAX_RETRIES=2

# ============ 思考模式 (deepseek-v4-flash thinking_mode) ============
# 官方文档: https://api-docs.deepseek.com/zh-cn/guides/thinking_mode
# 启用后模型先输出思维链再输出最终回答, 提升准确性
# reasoning_effort 支持 high/max (low/medium 会被映射为 high, 故不使用 low)
ENABLE_THINKING_MODE=true
THINKING_EFFORT_EASY=high
THINKING_EFFORT_MEDIUM=high
THINKING_EFFORT_HARD=max
THINKING_EFFORT_EXTREME=max
THINKING_EFFORT_DEFAULT=high

# ============ Kali SSH 配置（阶段一启用，阶段二可留空）============
KALI_HOST=<kali-host>
KALI_PORT=22
KALI_USER=root
# 二选一：密码或 SSH Key 路径（Key 优先）
KALI_PASS=password
KALI_KEY_PATH=

# ============ 熔断阈值 ============
MAX_STEPS=35
MAX_TASK_TIME=1800
MAX_COST_LIMIT=1.5

# ============ 数据库（阶段三/四启用）============
SQLITE_PATH=./data/ctf.db
CHROMA_PATH=./data/chroma

# ============ 日志 ============
LOG_LEVEL=INFO

# ============ 多解题器 (swarm) 与总指挥 (WING-Corvus) ============
# SWARM_ENABLED: 同题三风格并行 (true=所有难度 3 路并行)
SWARM_ENABLED=true
# SWARM_COMMANDER_ENABLED: 总指挥三层协作 (领题分工/方向指令/自动降级回雁阵)
SWARM_COMMANDER_ENABLED=true
# 巡查发起间隔 (步, 范围 5~10)
COORDINATOR_PATROL_GAP=5

# ============ 执行层 (Docker 优先) ============
# Docker 容器执行层 (true=默认; daemon 不可用自动降级 ssh)
DOCKER_ENABLED=true
# 本地构建镜像 wing-goose:v2; 或直接使用发布镜像 ghcr.io/cimen101/wing-docker:v6.2
DOCKER_IMAGE=ghcr.io/cimen101/wing-docker:v6.2
# Kali SSH 路由开关 (默认关闭: 执行层只用 Docker)
KALI_ENABLED=false

# ============ 模型路由模式 ============
# go=只走 go 套餐 (国内直连快, 冲榜稳定); auto=zen→go→官方 三级降级
LLM_PROVIDER=go

# ============ 分层 LLM 覆盖 (Sprint 39, 可选) ============
# 各层可独立指定 provider[:model], 默认空 = 全部跟随全局路由 (LLM_PROVIDER 决定).
# layer 取值: commander(总指挥) / strategy(战略层巡查) / tactic(战术层主循环)
# provider 取值: zen / go / fallback / pro
# 示例: 总指挥与战略层用官方 pro, 战术层保持 go flash:
# LAYER_LLM_MAP=commander=pro,strategy=pro:deepseek-v4-pro
# 也可通过运行参数 --layer-llm strategy=pro 覆盖 (solve.py 支持, 优先级高于 env)

# ============ 多模态视觉识别 (vision_analyze, Sprint 41 起 key 必填) ============
# vision_analyze 工具 (图片/视频/音频理解) 依赖多模态 API, key 从环境变量注入容器脚本
VISION_API_KEY=sk-xxx
# 可选覆盖 (默认即以下值):
# VISION_API_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
# VISION_API_MODEL=mimo-v2.5
